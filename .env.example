# --- required ---
WEBHOOK_SECRET=change-me-to-a-long-random-string
GITHUB_TOKEN=github_pat_xxx            # fine-grained PAT: Actions (read), Pull requests (write), Contents (write)
ANTHROPIC_API_KEY=sk-ant-xxx           # not needed when LLM_PROVIDER=mock

# --- optional ---
LLM_PROVIDER=anthropic                 # anthropic | mock
LLM_MODEL=claude-sonnet-5-5
REDIS_URL=                             # docker-compose sets this for you
ALLOWED_REPOS=                         # e.g. yourname/todo-app,yourname/other-repo (empty = any signed repo)
DRY_RUN=true                           # true = log the comment instead of posting it (start here!)
